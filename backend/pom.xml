<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <profiles>
        <profile>
            <id>local</id>
            <properties>
                <spring.profiles.active>local</spring.profiles.active>
            </properties>
        </profile>
    </profiles>

    <parent>
        <groupId>ch.reinhard</groupId>
        <artifactId>cashcontrol-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>


    <artifactId>backend</artifactId>
    <packaging>jar</packaging>
    <name>backend</name>



    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>9.1.3.Final</version>
        </dependency>
        <!--		<dependency>-->
        <!--			<groupId>jakarta.validation</groupId>-->
        <!--			<artifactId>jakarta.validation-api</artifactId>-->
        <!--			<version>3.0.1</version>-->
        <!--		</dependency>-->
        <!-- Spring Boot 4 hat die Flyway-Autoconfiguration in ein eigenes Modul ausgelagert,
             das nur noch ueber diesen Starter (statt der frueheren rohen flyway-core-Dependency)
             eingebunden wird. Version wird von der Spring-Boot-BOM verwaltet; damit sollte auch
             der fruehere cleanOnValidationError-NoSuchMethodError (siehe Schritt 4) behoben sein,
             da Spring Boot die eigene Autoconfiguration entsprechend aktualisiert hat. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 hat spring-boot-test-autoconfigure modularisiert; @WebMvcTest und
             @AutoConfigureTestDatabase erfordern jetzt diese eigenen Test-Starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x: Module heissen jetzt testcontainers-<modul> -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.aventrix.jnanoid/jnanoid -->
        <dependency>
            <groupId>com.aventrix.jnanoid</groupId>
            <artifactId>jnanoid</artifactId>
            <version>2.0.0</version>
        </dependency>

        <!-- OpenApi -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- springdoc 3.x ist die fuer Spring Boot 4 / Jakarta EE 11 kompatible Major-Version. -->
            <version>3.1.0</version>
        </dependency>

        <!-- Query DSL: das Original com.querydsl ist unmaintained (letztes Release 2021).
             Umgestiegen auf den aktiv gepflegten OpenFeign-Fork (mit Hibernate-7-Support),
             siehe https://openfeign.github.io/querydsl/migration. Java-Packages bleiben com.querydsl.*,
             es aendern sich nur GroupId, Classifier und Version. Der Annotation-Processor
             (querydsl-apt) wird unten im maven-compiler-plugin als annotationProcessorPath
             eingebunden statt als eigene provided-Dependency. -->
        <dependency>
            <groupId>io.github.openfeign.querydsl</groupId>
            <artifactId>querydsl-jpa</artifactId>
            <version>7.1</version>
        </dependency>

        <!-- Thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/org.xhtmlrenderer/flying-saucer-pdf -->
        <dependency>
            <groupId>org.xhtmlrenderer</groupId>
            <artifactId>flying-saucer-pdf</artifactId>
            <version>10.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-resources</id>
                        <phase>validate</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/classes/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.parent.basedir}/frontend/dist/frontend/browser</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- War bisher nicht gepinnt -> stiller Fallback auf die uralte Default-Version 3.1,
                     die die annotationProcessorPaths-Konfiguration unten nicht unterstuetzt. -->
                <version>3.16.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.openfeign.querydsl</groupId>
                            <artifactId>querydsl-apt</artifactId>
                            <version>7.1</version>
                            <classifier>jpa</classifier>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <!-- Damit ein Manifest File erstellt wird und das Jar-File executable wird-->
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Classifier setzen, damit das normale (nicht-ausfuehrbare) Jar mit flacher
                         Klassenstruktur das Haupt-Artefakt bleibt. Ohne Classifier ersetzt repackage
                         das Haupt-Artefakt durch die ausfuehrbare Jar (Klassen unter BOOT-INF/classes/
                         verschachtelt), was dazu fuehrt, dass Failsafe (laeuft nach der package-Phase)
                         Projektklassen ueber dieses Jar nicht mehr findet (NoClassDefFoundError). -->
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <ratchetFrom>origin/master</ratchetFrom>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <importOrder />
                        <removeUnusedImports />
                        <toggleOffOn/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                        <indent>
                            <tabs>true</tabs>
                            <spacesPerTab>4</spacesPerTab>
                        </indent>
                        <palantirJavaFormat/>
                    </java>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.12.0</version>
                <executions>
                    <execution>
                        <id>generate-spring-server</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <!-- 1. Deine OpenAPI-Spec -->
                            <inputSpec>${project.basedir}/src/main/resources/api-spec/cashcontrol.yaml</inputSpec>

                            <!-- 2. Generator und Bibliothek -->
                            <generatorName>spring</generatorName>
                            <library>spring-boot</library>

                            <!-- 3. Paketnamen für API-Interfaces und DTO-Modelle -->
                            <apiPackage>ch.reinhard.cashcontrol.openapi.api</apiPackage>
                            <modelPackage>ch.reinhard.cashcontrol.openapi.model</modelPackage>

                            <!-- 4. Zielordner für generierten Code -->
                            <output>${project.build.directory}/generated-sources/openapi</output>

                            <!-- 5. Nur bestimmte „Supporting Files“ erzeugen -->
                            <supportingFilesToGenerate>
                                ApiUtil.java
                            </supportingFilesToGenerate>

                            <!-- 6. Feintuning via configOptions -->
                            <configOptions>
                                <!-- verdrängt javax.* durch jakarta.* -->
                                <useSpringBoot3>true</useSpringBoot3>
                                <!-- nur Interfaces, keine Controller -->
                                <interfaceOnly>true</interfaceOnly>
                                <!-- deaktiviert alle default-Methoden im Interface -->
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <!-- An Tag-namen in der Spec ausrichten -->
                                <useTags>true</useTags>

                                <openApiNullable>false</openApiNullable>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Build Helper Plugin, um generated-sources als Source-Root hinzuzufügen -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-openapi-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <!-- Pfad zu deinem generated-sources-Ordner -->
                                <source>${project.build.directory}/generated-sources/openapi/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>

